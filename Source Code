# 5. Main pipeline
# ------------------------------
def main():
    device = 'cuda' if torch.cuda.is_available() else 'cpu'
    print("Loading CelebA data...")
    train_loader, val_loader, test_loader = get_celeba_loaders(batch_size=64)
    
    print("Initializing model...")
    model = get_model()
    
    print("Phase 1: Emergent Subnetwork Search (without sensitive labels)...")
    debiased_model, mask = emergent_subnetwork_search(model, train_loader, val_loader, sparsity_target=0.3, pruning_steps=5, device=device)
    
    print("Phase 2: Training Sparse Autoencoder for explainability...")
    sae, activations = train_sae(debiased_model, train_loader, layer_name='avgpool', hidden_dim=128, epochs=20, device=device)
    
    print("Auditing fairness...")
    # Evaluate fairness on test set (which has sensitive labels)
    from sklearn.metrics import confusion_matrix
    debiased_model.eval()
    all_preds = []
    all_labels = []
    all_sensitive = []
    with torch.no_grad():
        for images, labels, sensitive in test_loader:
            images = images.to(device)
            outputs = debiased_model(images)
            preds = torch.argmax(outputs, dim=1).cpu()
            all_preds.extend(preds.numpy())
            all_labels.extend(labels.numpy())
            all_sensitive.extend(sensitive.numpy())
    
    # Equalized Odds difference: for each sensitive group, compute TPR and FPR
    groups = np.unique(all_sensitive)
    tpr = {}
    fpr = {}
    for g in groups:
        idx = np.where(np.array(all_sensitive) == g)[0]
        y_true = np.array(all_labels)[idx]
        y_pred = np.array(all_preds)[idx]
        tn, fp, fn, tp = confusion_matrix(y_true, y_pred, labels=[0,1]).ravel()
        tpr[g] = tp / (tp + fn) if (tp+fn)>0 else 0
        fpr[g] = fp / (fp + tn) if (fp+tn)>0 else 0
    eo_diff = max(abs(tpr[0]-tpr[1]), abs(fpr[0]-fpr[1]))
    print(f"Equalized Odds difference on test set: {eo_diff:.4f}")
    print("Triple-E framework completed.")

if __name__ == '__main__':
    main()
