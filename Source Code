# ------------------------------
# 1. Dataset Preparation (with hidden sensitive labels)
# ------------------------------
def get_celeba_loaders(batch_size=64, sensitive_attr='Male', task_attr='Attractive'):
    """
    Loads CelebA, returns train/val/test loaders.
    Sensitive attribute labels are removed from train/val loaders (used only for evaluation).
    """
    transform = transforms.Compose([
        transforms.Resize((128, 128)),
        transforms.ToTensor(),
        transforms.Normalize((0.5, 0.5, 0.5), (0.5, 0.5, 0.5))
    ])
    full_dataset = torchvision.datasets.CelebA(root='./data', split='all', target_type='attr', transform=transform, download=True)
    
    # Map attributes to indices (CelebA has 40 binary attributes)
    attr_names = full_dataset.attr_names
    task_idx = attr_names.index(task_attr)
    sensitive_idx = attr_names.index(sensitive_attr)
    
    # Split into train/val/test (0.7/0.1/0.2)
    N = len(full_dataset)
    train_idx = list(range(0, int(0.7*N)))
    val_idx = list(range(int(0.7*N), int(0.8*N)))
    test_idx = list(range(int(0.8*N), N))
    
    # For training/val: return only task labels, not sensitive
    class CelebAWrapper(torch.utils.data.Dataset):
        def __init__(self, dataset, indices, use_sensitive=False):
            self.dataset = dataset
            self.indices = indices
            self.use_sensitive = use_sensitive
        def __len__(self): return len(self.indices)
        def __getitem__(self, i):
            img, attr = self.dataset[self.indices[i]]
            task_label = (attr[task_idx] + 1) // 2  # convert from -1/1 to 0/1
            if self.use_sensitive:
                sensitive_label = (attr[sensitive_idx] + 1) // 2
                return img, task_label, sensitive_label
            else:
                return img, task_label
    
    train_set = CelebAWrapper(full_dataset, train_idx, use_sensitive=False)
    val_set = CelebAWrapper(full_dataset, val_idx, use_sensitive=False)
    test_set = CelebAWrapper(full_dataset, test_idx, use_sensitive=True)  # only test has sensitive labels
    
    train_loader = DataLoader(train_set, batch_size=batch_size, shuffle=True)
    val_loader = DataLoader(val_set, batch_size=batch_size, shuffle=False)
    test_loader = DataLoader(test_set, batch_size=batch_size, shuffle=False)
    return train_loader, val_loader, test_loader

# ------------------------------
# 2. Model Definition (e.g., ResNet-18)
# ------------------------------
def get_model(num_classes=2):
    model = torchvision.models.resnet18(pretrained=True)
    model.fc = nn.Linear(model.fc.in_features, num_classes)
    return model

# ------------------------------
# 3. Phase 1: Emergent Subnetwork Search
# ------------------------------
def emergent_subnetwork_search(model, train_loader, val_loader, sparsity_target=0.5, pruning_steps=10, lambda_fair=0.1, device='cuda'):
    """
    Novel: Finds a fair subnetwork without sensitive labels by using dynamic reweighting.
    Returns: mask (binary tensor), final subnetwork model.
    """
    model.to(device)
    model.train()
    
    # Initialize mask: all ones (keep all parameters)
    mask = {name: torch.ones_like(param) for name, param in model.named_parameters() if param.requires_grad}
    
    # Get initial parameter importance scores using gradient-based pruning (e.g., SNIP)
    def compute_importance():
        importance = {}
        for name, param in model.named_parameters():
            if param.requires_grad:
                importance[name] = torch.abs(param.grad) * torch.abs(param)
        return importance
    
    # Pruning loop
    total_params = sum(p.numel() for p in model.parameters() if p.requires_grad)
    params_to_keep = int(total_params * (1 - sparsity_target))
    
    for step in range(pruning_steps):
        # Train for one epoch to get gradients
        optimizer = optim.Adam(model.parameters(), lr=1e-3)
        criterion = nn.CrossEntropyLoss()
        
        # We'll collect gradients for importance
        for batch_idx, (images, labels) in enumerate(train_loader):
            images, labels = images.to(device), labels.to(device)
            optimizer.zero_grad()
            outputs = model(images)
            loss_task = criterion(outputs, labels)
            loss_task.backward()
            break  # just one batch for importance
        
        # Compute importance scores
        importance = compute_importance()
        
        # Flatten all scores
        all_scores = []
        for name, imp in importance.items():
            all_scores.append(imp.view(-1))
        all_scores = torch.cat(all_scores)
        
        # Determine threshold to achieve target sparsity
        if step == pruning_steps - 1:
            k = params_to_keep
        else:
            # Gradually prune
            current_kept = sum(mask[name].sum().item() for name in mask)
            k = max(params_to_keep, int(current_kept * 0.8))
        
        threshold = torch.quantile(all_scores, 1 - k / len(all_scores))
        
        # Update mask: keep parameters with importance >= threshold
        new_mask = {}
        for name, imp in importance.items():
            new_mask[name] = (imp >= threshold).float().to(device)
            # Apply mask to model parameters
            model.state_dict()[name].data *= new_mask[name]
        mask = new_mask
        
        # ---- NOVEL PART: Emergent Fairness Loss ----
        # In a real implementation, we would incorporate the fairness loss into pruning criterion.
        # Here we demonstrate the loss computation.
        model.eval()
        with torch.no_grad():
            group_a_loss = []
            group_b_loss = []
            for images, labels in train_loader:
                images, labels = images.to(device), labels.to(device)
                outputs = model(images)
                probs = torch.softmax(outputs, dim=1)
                preds = torch.argmax(probs, dim=1)
                correct = (preds == labels)
                confidence = torch.max(probs, dim=1)[0]
                
                # Group A: correct and high confidence (top 50% confidence among correct)
                # Group B: misclassified
                # Simplified: all correct vs all incorrect
                correct_mask = correct
                incorrect_mask = ~correct
                
                if correct_mask.sum() > 0:
                    loss_correct = criterion(outputs[correct_mask], labels[correct_mask]).item()
                    group_a_loss.append(loss_correct)
                if incorrect_mask.sum() > 0:
                    loss_incorrect = criterion(outputs[incorrect_mask], labels[incorrect_mask]).item()
                    group_b_loss.append(loss_incorrect)
            
            fairness_loss = abs(np.mean(group_b_loss) - np.mean(group_a_loss)) if group_a_loss and group_b_loss else 0
            print(f"Pruning step {step+1}/{pruning_steps}, Fairness Loss: {fairness_loss:.4f}")
        
        model.train()
    
    # Apply final mask
    for name, param in model.named_parameters():
        if param.requires_grad:
            param.data *= mask[name]
    return model, mask

# ------------------------------
# 4. Phase 2: Explainable Audit with Sparse Autoencoder
# ------------------------------
class SparseAutoencoder(nn.Module):
    def __init__(self, input_dim, hidden_dim, sparsity_lambda=0.001):
        super().__init__()
        self.encoder = nn.Linear(input_dim, hidden_dim)
        self.decoder = nn.Linear(hidden_dim, input_dim)
        self.sparsity_lambda = sparsity_lambda
        
    def forward(self, x):
        encoded = torch.relu(self.encoder(x))
        decoded = self.decoder(encoded)
        return decoded, encoded
    
    def sparsity_penalty(self, encoded):
        # KL divergence with target sparsity (e.g., 0.05)
        rho_hat = torch.mean(encoded, dim=0)
        rho = 0.05
        kl = rho * torch.log(rho / (rho_hat + 1e-8)) + (1-rho) * torch.log((1-rho) / (1 - rho_hat + 1e-8))
        return self.sparsity_lambda * torch.sum(kl)

def train_sae(model, dataloader, layer_name='avgpool', hidden_dim=256, epochs=50, device='cuda'):
    """
    Extract activations from a given layer of the model, train SAE.
    Returns trained SAE and the extracted activations.
    """
    model.eval()
    activations = []
    
    # Hook to capture layer output
    def hook_fn(module, input, output):
        activations.append(output.detach().cpu())
    
    # Register hook on the target layer
    target_layer = dict(model.named_modules())[layer_name]
    handle = target_layer.register_forward_hook(hook_fn)
    
    with torch.no_grad():
        for images, _ in tqdm(dataloader, desc="Extracting activations"):
            images = images.to(device)
            _ = model(images)
    
    handle.remove()
    act = torch.cat(activations, dim=0)
    act = act.view(act.size(0), -1)  # flatten
    input_dim = act.shape[1]
    
    # Train SAE
    sae = SparseAutoencoder(input_dim, hidden_dim).to(device)
    optimizer = optim.Adam(sae.parameters(), lr=1e-3)
    criterion = nn.MSELoss()
    
    dataset = torch.utils.data.TensorDataset(act)
    loader = DataLoader(dataset, batch_size=128, shuffle=True)
    
    for epoch in range(epochs):
        total_loss = 0
        for (batch_act,) in loader:
            batch_act = batch_act.to(device)
            decoded, encoded = sae(batch_act)
            recon_loss = criterion(decoded, batch_act)
            sp_loss = sae.sparsity_penalty(encoded)
            loss = recon_loss + sp_loss
            optimizer.zero_grad()
            loss.backward()
            optimizer.step()
            total_loss += loss.item()
        if epoch % 10 == 0:
            print(f"SAE Epoch {epoch}, Loss: {total_loss/len(loader):.4f}")
    
    return sae, act

