import numpy as np
from sklearn.datasets import make_classification
from sklearn.neural_network import MLPClassifier
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score, confusion_matrix
import copy

# ------------------------------
# 1. Generate synthetic dataset with a sensitive attribute
# ------------------------------
def generate_biased_data(n_samples=2000, bias_strength=0.8):
    """
    Create a binary classification task where the sensitive attribute (e.g., group=0/1)
    causes distribution shift. The label is more predictable for group 0.
    """
    # Base features
    X, y = make_classification(n_samples=n_samples, n_features=10, n_informative=8,
                               n_redundant=2, random_state=42)
    # Sensitive attribute: group 0 (60% of samples) and group 1 (40%)
    sensitive = np.random.choice([0, 1], size=n_samples, p=[0.6, 0.4])
    # Introduce bias: flip some labels for group 1 to make them harder
    bias_mask = (sensitive == 1) & (np.random.rand(n_samples) < bias_strength)
    y[bias_mask] = 1 - y[bias_mask]  # flip label
    return X, y, sensitive

# ------------------------------
# 2. Simple neural network wrapper (using MLPClassifier)
#    This stands in for a deep model. We'll simulate "subnetwork" by zeroing weights.
# ------------------------------
class SimpleNN:
    def __init__(self, hidden_layer_sizes=(20,), max_iter=100, random_state=42):
        self.model = MLPClassifier(hidden_layer_sizes=hidden_layer_sizes,
                                   activation='relu', max_iter=max_iter,
                                   random_state=random_state, verbose=False)
        self.mask = None  # binary mask for weights (1=keep, 0=pruned)
    
    def fit(self, X, y):
        self.model.fit(X, y)
        n_weights = sum([np.prod(c.shape) for c in self.model.coefs_]) + sum([np.prod(i.shape) for i in self.model.intercepts_])
        self.mask = [np.ones_like(c) for c in self.model.coefs_] + [np.ones_like(i) for i in self.model.intercepts_]
    
    def predict(self, X):
        return self.model.predict(X)
    
    def predict_proba(self, X):
        return self.model.predict_proba(X)
    
    def apply_mask(self):
        """Zero out weights where mask is 0."""
        idx = 0
        for i, coef in enumerate(self.model.coefs_):
            self.model.coefs_[i] = coef * self.mask[idx]
            idx += 1
        for i, intercept in enumerate(self.model.intercepts_):
            self.model.intercepts_[i] = intercept * self.mask[idx]
            idx += 1
    
    def get_flat_weights(self):
        """Return all weights as a flat numpy array."""
        flat = []
        for coef in self.model.coefs_:
            flat.append(coef.flatten())
        for intercept in self.model.intercepts_:
            flat.append(intercept.flatten())
        return np.concatenate(flat)
    
    def set_flat_weights(self, flat_weights):
        """Restore weights from flat array."""
        idx = 0
        for i, coef in enumerate(self.model.coefs_):
            shape = coef.shape
            size = np.prod(shape)
            self.model.coefs_[i] = flat_weights[idx:idx+size].reshape(shape)
            idx += size
        for i, intercept in enumerate(self.model.intercepts_):
            shape = intercept.shape
            size = np.prod(shape)
            self.model.intercepts_[i] = flat_weights[idx:idx+size].reshape(shape)
            idx += size

# ------------------------------
# 3. Phase 1: Emergent Subnetwork Search (without sensitive labels)
# ------------------------------
def emergent_subnetwork_search(model, X_train, y_train, sparsity_target=0.3,
                              pruning_steps=5, lambda_fair=0.1):
    """
    Prune the model by iteratively removing weights that cause high fairness loss.
    Fairness loss is computed as the difference in loss between correctly classified
    (confident) and misclassified samples – a proxy for bias.
    """
    model = copy.deepcopy(model)
    model.fit(X_train, y_train)  # initial training
    
    # Get initial weights and create mask
    flat_weights = model.get_flat_weights()
    n_total = len(flat_weights)
    n_keep = int(n_total * (1 - sparsity_target))
    
    # Importance scores: absolute weight magnitude (simple proxy)
    importance = np.abs(flat_weights)
    
    # Pruning loop
    current_keep = n_total
    for step in range(pruning_steps):
        # Determine how many weights to keep at this step
        if step == pruning_steps - 1:
            target_keep = n_keep
        else:
            target_keep = max(n_keep, int(current_keep * 0.7))
        
        # Compute fairness loss on a small batch (simulate dynamic groups)
        preds = model.predict(X_train)
        probs = model.predict_proba(X_train)[:, 1]
        
        # Group A: correctly classified with high confidence (top 50% confidence among correct)
        correct = (preds == y_train)
        if np.sum(correct) > 0:
            conf_correct = probs[correct] if np.any(correct) else np.array([])
            # In binary, high confidence means close to 0 or 1
            conf_correct = np.abs(conf_correct - 0.5)  # distance from 0.5
            threshold = np.percentile(conf_correct, 50) if len(conf_correct) > 0 else 0
            group_A = correct & (conf_correct >= threshold)
        else:
            group_A = np.zeros(len(y_train), dtype=bool)
        
        # Group B: misclassified samples
        group_B = ~correct
        
        # Loss proxy: negative log probability of correct class (simplified)
        def group_loss(group):
            if np.sum(group) == 0:
                return 0
            y_group = y_train[group]
            p_group = probs[group]
            # Cross-entropy like: -log(p_correct)
            loss = -np.log(p_group) if y_group[0]==1 else -np.log(1-p_group)
            return np.mean(loss)
        
        loss_A = group_loss(group_A)
        loss_B = group_loss(group_B)
        fairness_loss = abs(loss_B - loss_A)
        
        # Adjust importance: weights that contribute more to fairness loss get lower importance
        # For simplicity, we keep the original importance, but in reality we'd use gradient.
        # Here, we just print the fairness loss.
        print(f"Step {step+1}/{pruning_steps}, Fairness loss (proxy bias): {fairness_loss:.4f}")
        
        # Prune: keep top-k weights by importance
        if len(importance) > target_keep:
            threshold = np.sort(importance)[-target_keep]
            new_mask_flat = (importance >= threshold).astype(float)
        else:
            new_mask_flat = np.ones_like(importance)
        
        # Apply mask to weights
        flat_weights_masked = flat_weights * new_mask_flat
        model.set_flat_weights(flat_weights_masked)
        current_keep = np.sum(new_mask_flat)
    
    # Refit the model with only kept weights (by resetting and fitting with masked initialization?)
    # For simplicity, we just return the pruned model.
    return model

# ------------------------------
# 4. Phase 2: Explainable Audit with Sparse Autoencoder (NumPy only)
# ------------------------------
class SparseAutoencoder:
    def __init__(self, input_dim, hidden_dim, sparsity_target=0.05, lambda_sparse=0.001):
        self.W_enc = np.random.randn(input_dim, hidden_dim) * 0.01
        self.b_enc = np.zeros(hidden_dim)
        self.W_dec = np.random.randn(hidden_dim, input_dim) * 0.01
        self.b_dec = np.zeros(input_dim)
        self.sparsity_target = sparsity_target
        self.lambda_sparse = lambda_sparse
        
    def encode(self, x):
        return np.maximum(0, x @ self.W_enc + self.b_enc)  # ReLU
    
    def decode(self, h):
        return h @ self.W_dec + self.b_dec
    
    def forward(self, x):
        h = self.encode(x)
        x_recon = self.decode(h)
        return x_recon, h
    
    def train(self, X, epochs=50, lr=0.01, batch_size=32):
        n_samples = X.shape[0]
        for epoch in range(epochs):
            indices = np.random.permutation(n_samples)
            total_loss = 0
            for i in range(0, n_samples, batch_size):
                batch = X[indices[i:i+batch_size]]
                # Forward
                h = np.maximum(0, batch @ self.W_enc + self.b_enc)
                recon = h @ self.W_dec + self.b_dec
                # Reconstruction loss (MSE)
                recon_loss = np.mean((recon - batch) ** 2)
                # Sparsity penalty (KL divergence)
                rho_hat = np.mean(h, axis=0)
                kl = self.sparsity_target * np.log(self.sparsity_target / (rho_hat + 1e-8)) + \
                     (1 - self.sparsity_target) * np.log((1 - self.sparsity_target) / (1 - rho_hat + 1e-8))
                sp_loss = self.lambda_sparse * np.sum(kl)
                loss = recon_loss + sp_loss
                total_loss += loss
                # Backprop (simplified gradients)
                grad_recon = 2 * (recon - batch) / batch.shape[0]
                grad_W_dec = h.T @ grad_recon
                grad_b_dec = np.sum(grad_recon, axis=0)
                grad_h = grad_recon @ self.W_dec.T
                grad_h[h <= 0] = 0  # ReLU derivative
                grad_W_enc = batch.T @ grad_h
                grad_b_enc = np.sum(grad_h, axis=0)
                # Update
                self.W_dec -= lr * grad_W_dec
                self.b_dec -= lr * grad_b_dec
                self.W_enc -= lr * grad_W_enc
                self.b_enc -= lr * grad_b_enc
            if epoch % 10 == 0:
                print(f"SAE Epoch {epoch}, Loss: {total_loss/((n_samples+batch_size-1)//batch_size):.4f}")
    
    def get_feature_correlations(self, X, sensitive):
        """Compute correlation between each hidden feature and sensitive attribute."""
        h = self.encode(X)
        correlations = []
        for i in range(h.shape[1]):
            corr = np.corrcoef(h[:, i], sensitive)[0, 1]
            correlations.append(corr)
        return np.array(correlations)

# ------------------------------
# 5. Main Pipeline
# ------------------------------
def main():
    print("Generating synthetic biased dataset...")
    X, y, sensitive = generate_biased_data(n_samples=2000, bias_strength=0.7)
    X_train, X_test, y_train, y_test, s_train, s_test = train_test_split(
        X, y, sensitive, test_size=0.3, random_state=42)
    
    # Remove sensitive labels from training (simulate privacy)
    print("Training without sensitive labels (only task labels)...")
    model = SimpleNN(hidden_layer_sizes=(10,))
    
    print("\n=== Phase 1: Emergent Subnetwork Search ===")
    debiased_model = emergent_subnetwork_search(model, X_train, y_train,
                                                sparsity_target=0.3,
                                                pruning_steps=3)
    
    # Evaluate fairness on test set (using the hidden sensitive labels)
    y_pred = debiased_model.predict(X_test)
    acc = accuracy_score(y_test, y_pred)
    # Compute equalized odds difference
    def eo_difference(y_true, y_pred, sensitive):
        groups = np.unique(sensitive)
        tpr = {}
        fpr = {}
        for g in groups:
            idx = np.where(sensitive == g)[0]
            tn, fp, fn, tp = confusion_matrix(y_true[idx], y_pred[idx], labels=[0,1]).ravel()
            tpr[g] = tp / (tp + fn) if (tp+fn)>0 else 0
            fpr[g] = fp / (fp + tn) if (fp+tn)>0 else 0
        return max(abs(tpr[0]-tpr[1]), abs(fpr[0]-fpr[1]))
    
    eo_diff = eo_difference(y_test, y_pred, s_test)
    print(f"\nAfter debiasing: Test Accuracy = {acc:.3f}, Equalized Odds Diff = {eo_diff:.3f}")
    
    print("\n=== Phase 2: Explainable Audit with Sparse Autoencoder ===")
    # For audit, we need hidden layer activations. Extract from the first hidden layer.
    # In our SimpleNN, we can get intermediate activations by forward pass with coefs_ etc.
    # We'll simulate by using the trained model's coefs to compute activations for training set.
    def get_hidden_activations(model, X):
        # First hidden layer: input -> first coefs + intercept
        a1 = np.maximum(0, X @ model.model.coefs_[0] + model.model.intercepts_[0])
        return a1
    
    X_train_acts = get_hidden_activations(debiased_model, X_train)
    sae = SparseAutoencoder(input_dim=X_train_acts.shape[1], hidden_dim=5, sparsity_target=0.2)
    sae.train(X_train_acts, epochs=30, lr=0.05)
    
    # Audit: check correlation between SAE features and sensitive attribute
    # (using test set, because we have sensitive labels)
    X_test_acts = get_hidden_activations(debiased_model, X_test)
    correlations = sae.get_feature_correlations(X_test_acts, s_test)
    print("Correlation of each SAE feature with sensitive attribute:", np.round(correlations, 3))
    max_corr = np.max(np.abs(correlations))
    if max_corr < 0.2:
        print("✅ Audit passed: No strong correlation with sensitive attribute.")
    else:
        print(f"⚠️ Audit warning: Some features correlate with sensitive attribute (max |r| = {max_corr:.2f})")
    
    print("\nTriple-E framework execution complete!")

if __name__ == "__main__":
    main()
